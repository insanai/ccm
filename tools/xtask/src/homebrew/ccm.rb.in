# Generated by cargo xtask homebrew from insanai/ccm's release checksums.
class Ccm < Formula
  desc "Source counts, change impact, evidence, and development cost scenarios"
  homepage "https://insanai.github.io/ccm/"
  version "@VERSION@"
  license "LGPL-3.0-or-later"

  on_macos do
    on_arm do
      url "https://github.com/insanai/ccm/releases/download/v@VERSION@/ccm-macos-arm64.tar.gz"
      sha256 "@SHA256_macos-arm64@"
    end
    on_intel do
      url "https://github.com/insanai/ccm/releases/download/v@VERSION@/ccm-macos-amd64.tar.gz"
      sha256 "@SHA256_macos-amd64@"
    end
  end

  on_linux do
    on_arm do
      url "https://github.com/insanai/ccm/releases/download/v@VERSION@/ccm-linux-arm64.tar.gz"
      sha256 "@SHA256_linux-arm64@"
    end
    on_intel do
      url "https://github.com/insanai/ccm/releases/download/v@VERSION@/ccm-linux-amd64.tar.gz"
      sha256 "@SHA256_linux-amd64@"
    end
  end

  def install
    bin.install "ccm"
    doc.install "README.rst"
    pkgshare.install "BUILD-INFO.txt", "NOTICE", "COPYING", "COPYING.LESSER",
                     "LICENSE-language-data"
  end

  test do
    (testpath/"hello.rs").write "// A note\nfn main() {}\n"
    assert_match version.to_s, shell_output("#{bin}/ccm --version")
    report = shell_output("#{bin}/ccm --json --no-cost #{testpath}")
    assert_match '"code":1', report
    assert_match '"complete":true', report
  end
end
